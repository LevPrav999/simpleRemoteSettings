{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["cardLimit"],
  "properties": {
    "cardLimit": { "type": "integer", "minimum": 1, "maximum": 5 },
    "bannerImagePath": { "$ref": "#/$defs/assetPath" }
  },
  "additionalProperties": false,
  "$defs": {
    "assetPath": {
      "type": "string",
      "maxLength": 505,
      "pattern": "^/cdn/(?:[A-Za-z0-9_-][A-Za-z0-9._-]*/)*[A-Za-z0-9_-][A-Za-z0-9._-]*$"
    }
  }
}
